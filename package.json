{
  "name": "which-dialect-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build:data": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-language.ts",
    "build:data:all": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-all.ts",
    "fetch:data": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fetch-data.ts",
    "build:picks": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/picks.ts",
    "picks-sheet": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/picks-sheet.ts",
    "build": "npm run build -w which-dialect",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test packages/core/test/*.test.ts",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p tsconfig.scripts.json",
    "evaluate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/evaluate.ts",
    "evaluate:spelling": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/evaluate-spelling.ts"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
