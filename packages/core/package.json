{
  "name": "which-dialect",
  "version": "0.5.6",
  "description": "Translate words between languages and dialects, meaning by meaning, starting with Vietnamese (Northern, Central, Southern) and English, with Wiktionary data loaded on demand. More languages are planned.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dictionary",
    "dialect",
    "regional",
    "translation",
    "language-learning",
    "wiktionary",
    "vietnamese"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyen18/which-dialect.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nguyen18/which-dialect#readme"
}
